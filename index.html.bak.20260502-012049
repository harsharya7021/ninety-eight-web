/* ============================================================
   4. v2.7 · MAGNETIC CTAs (hover-only cursor pull)
   Tag the elements at runtime so the HTML stays clean. Throttle
   the mousemove through one rAF tick. Skip when offscreen.
   ============================================================ */

const magnets = [...document.querySelectorAll('.nav .cta, .contact .cta-big, .svc-row .arrow')];
magnets.forEach(el => el.classList.add('magnetic'));

const PULL_RADIUS = 110;       // px — engage when cursor is within this
const PULL_STRENGTH = 0.32;    // 0..1 — how much of the offset to apply

let _magX = -9999, _magY = -9999, _magQueued = false;
function _magTick(){
  _magQueued = false;
  for (let i = 0; i < magnets.length; i++) {
    const el = magnets[i];
    const r = el.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) {
      if (el.classList.contains('pulling')) { el.classList.remove('pulling'); el.style.transform = ''; }
      continue;
    }
    const cx = r.left + r.width/2, cy = r.top + r.height/2;
    const dx = _magX - cx, dy = _magY - cy;
    const d = Math.hypot(dx, dy);
    if (d < PULL_RADIUS) {
      el.classList.add('pulling');
      el.style.transform = `translate(${dx*PULL_STRENGTH}px, ${dy*PULL_STRENGTH}px)`;
    } else if (el.classList.contains('pulling')) {
      el.classList.remove('pulling');
      el.style.transform = '';
    }
  }
}
window.addEventListener('mousemove', e => {
  _magX = e.clientX; _magY = e.clientY;
  if (!_magQueued) { _magQueued = true; requestAnimationFrame(_magTick); }
}, {passive:true});

/* ============================================================
   5. v2.9 · ROSTER CAROUSEL (scroll-snap + arrows + dots)
   The .roster-rail is a native horizontal scroll container with
   scroll-snap. We add prev/next buttons and clickable dots that
   call scrollTo(); we also observe scroll position to keep the
   active dot + button-disabled states in sync.
   ============================================================ */

(function initRosterCarousel(){
  const rail  = document.getElementById('roster-rail');
  const dots  = document.getElementById('roster-dots');
  const prev  = document.querySelector('.roster-nav .rn-prev');
  const next  = document.querySelector('.roster-nav .rn-next');
  if (!rail || !dots || !prev || !next) return;

  const slides = [...rail.querySelectorAll('.roster-slide')];
  if (!slides.length) return;

  // build dots
  dots.innerHTML = slides.map((_,i) => `<button type="button" class="dot" data-i="${i}" aria-label="Go to slide ${i+1}"></button>`).join('');
  const dotEls = [...dots.querySelectorAll('.dot')];

  function slideStep(){
    // distance from one slide-center to the next
    if (slides.length < 2) return slides[0].offsetWidth;
    return slides[1].getBoundingClientRect().left - slides[0].getBoundingClientRect().left;
  }

  function activeIndex(){
    const railRect = rail.getBoundingClientRect();
    const railCenter = railRect.left + railRect.width / 2;
    let best = 0, bestDist = Infinity;
    slides.forEach((s, i) => {
      const r = s.getBoundingClientRect();
      const c = r.left + r.width / 2;
      const d = Math.abs(c - railCenter);
      if (d < bestDist) { bestDist = d; best = i; }
    });
    return best;
  }

  function syncState(){
    const i = activeIndex();
    dotEls.forEach((d, di) => d.classList.toggle('active', di === i));
    prev.disabled = i === 0;
    next.disabled = i === slides.length - 1;
  }

  function goTo(i){
    i = Math.max(0, Math.min(slides.length - 1, i));
    const target = slides[i];
    const railRect = rail.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();
    // align target's center to rail's center
    const delta = (targetRect.left + targetRect.width/2) - (railRect.left + railRect.width/2);
    rail.scrollBy({left: delta, behavior: 'smooth'});
  }

  prev.addEventListener('click', () => goTo(activeIndex() - 1));
  next.addEventListener('click', () => goTo(activeIndex() + 1));
  dotEls.forEach(d => d.addEventListener('click', () => goTo(+d.dataset.i)));

  // keyboard support when rail has focus
  rail.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') { e.preventDefault(); goTo(activeIndex() + 1); }
    if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(activeIndex() - 1); }
  });

  // throttle scroll-driven sync through rAF
  let railQ = false;
  rail.addEventListener('scroll', () => {
    if (railQ) return;
    railQ = true;
    requestAnimationFrame(() => { railQ = false; syncState(); });
  }, {passive:true});

  // initial state
  syncState();
})();

/* ============================================================
   5b. v2.14 · ISHANT CAROUSEL (no-friction headline)
   Same scroll-snap pattern as the roster carousel — own selectors.
   ============================================================ */

(function initIshantCarousel(){
  const rail  = document.getElementById('ic-rail');
  const dots  = document.getElementById('ic-dots');
  const prev  = document.querySelector('.ic-nav .ic-prev');
  const next  = document.querySelector('.ic-nav .ic-next');
  if (!rail || !dots || !prev || !next) return;

  const slides = [...rail.querySelectorAll('.ic-slide')];
  if (!slides.length) return;

  dots.innerHTML = slides.map((_,i) => `<button type="button" class="dot" data-i="${i}" aria-label="Go to slide ${i+1}"></button>`).join('');
  const dotEls = [...dots.querySelectorAll('.dot')];

  function activeIndex(){
    const railRect = rail.getBoundingClientRect();
    const railCenter = railRect.left + railRect.width / 2;
    let best = 0, bestDist = Infinity;
    slides.forEach((s, i) => {
      const r = s.getBoundingClientRect();
      const c = r.left + r.width / 2;
      const d = Math.abs(c - railCenter);
