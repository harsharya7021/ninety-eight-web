  margin:-40vh 0;          /* pull the runway equally into hero & next section */
  position:relative;
  overflow:visible;
  z-index:5;
  background:transparent;
  pointer-events:none;
}

.train-img{
  position:sticky;
  top:50%;                 /* center vertically in viewport */
  display:block;
