/* ============================================================
   v2.13 · CASE DIALOGS — generic open/close machinery
   Any element with [data-case="name"] opens <dialog id="case-name">.
   Any [.cd-close] inside a case dialog closes it. Backdrop click
   also closes. Hash-based deep links (#case-name) auto-open on load.
   ============================================================ */

(function initCaseDialogs(){
  function openCase(name){
    const dlg = document.getElementById('case-' + name);
    if (!dlg) return false;
    if (typeof dlg.showModal === 'function') dlg.showModal();
    else dlg.setAttribute('open', '');
    // scroll the modal body to top (in case of re-open)
    const body = dlg.querySelector('.cd-body');
    if (body) body.scrollTop = 0;
    return true;
  }

  // Wire every [data-case] trigger
  document.querySelectorAll('[data-case]').forEach(el => {
    el.addEventListener('click', e => {
      const name = el.getAttribute('data-case');
      if (openCase(name)) e.preventDefault();
    });
    // Keyboard support for non-button triggers (e.g., the roster <article>)
    if (el.tagName !== 'A' && el.tagName !== 'BUTTON') {
      el.setAttribute('role', 'button');
      el.setAttribute('tabindex', '0');
      el.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openCase(el.getAttribute('data-case'));
        }
      });
    }
  });

  // Wire close + backdrop on every case-dialog
  document.querySelectorAll('.case-dialog').forEach(dlg => {
    const close = dlg.querySelector('.cd-close');
    if (close) close.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', e => {
      if (e.target === dlg) dlg.close();
    });
  });

  // Deep link: #case-ishant in the URL auto-opens the dialog on load
  function maybeOpenFromHash(){
    const h = window.location.hash;
    if (h && h.startsWith('#case-')) {
      const name = h.replace('#case-', '');
      openCase(name);
    }
  }
  window.addEventListener('hashchange', maybeOpenFromHash);
  // run after DOM settles
  setTimeout(maybeOpenFromHash, 50);
})();
