<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Ninety-Eight — A creative powerhouse. Business partners for hire.</title>
<meta name="description" content="Ninety-Eight is a creative powerhouse out of Delhi NCR, Bombay and Bangalore. Strategy, marketing, advertising, execution, financial modeling, market research — for founders who want a partner, not a vendor. Since 2020." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* ============================================================
   NINETY-EIGHT · ENTERTAINMENT · v2.1
   Hand-coded. No frameworks. Real motion.
   ============================================================ */

:root{
  --paper:#F4EFE0;
  --cream:#F5F0E1;
  --carbon:#0E0E10;
  --ink:#1F2330;
  --slate:#4B4F5C;
  --mute:#9a9280;

  /* 98 brand palette — as seen in the Mar 2023 deck */
  --royal:#1F4D8C;
  --red:#DD3D38;
  --gold:#F5B015;
  --green:#2F9E5E;
  --purple:#7E4DA5;
  --orange:#E87722;
  --brown:#7B5D3F;
  --pink:#E7497C;

  --display:'Inter Tight', system-ui, sans-serif;
  --serif:'Instrument Serif', 'Times New Roman', serif;
  --mono:'IBM Plex Mono', ui-monospace, monospace;

  --ease:cubic-bezier(.2,.7,.1,1);
}

*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--paper);color:var(--ink);font-family:var(--display);-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
body{overflow-x:hidden}
img,svg{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}

/* ---------- top progress bar ---------- */
#progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,var(--royal),var(--red),var(--gold),var(--green));z-index:9999;transition:width .12s linear}

/* ---------- custom cursor ---------- */
.cursor-dot,.cursor-ring{position:fixed;top:0;left:0;pointer-events:none;z-index:9998;mix-blend-mode:difference;transition:transform .2s var(--ease), width .2s var(--ease), height .2s var(--ease), opacity .2s ease, background .2s ease}
.cursor-dot{width:8px;height:8px;border-radius:50%;background:#fff;transform:translate(-50%,-50%)}
.cursor-ring{width:36px;height:36px;border-radius:999px;border:1.5px solid #fff;transform:translate(-50%,-50%)}
.cursor-ring.hover{width:72px;height:72px;background:var(--gold);border-color:var(--gold);mix-blend-mode:normal;opacity:.9}
@media (hover:none),(max-width:820px){.cursor-dot,.cursor-ring{display:none}}

/* ---------- nav ---------- */
.nav{position:fixed;top:18px;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:10px 28px;transition:all .3s var(--ease)}
.nav.scrolled{top:0;padding:12px 28px;background:rgba(244,239,224,.82);backdrop-filter:blur(14px);border-bottom:1px solid rgba(14,14,16,.08)}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:800;letter-spacing:-.01em;font-size:14px;line-height:1.05}
/* v2.27 · Real 98 badge — two colored circles (red 9, green 8) per brand deck */
.logo-mark{display:inline-flex;align-items:center;gap:2px;background:transparent}
.logo-mark svg{width:auto;height:30px;display:block}
.logo small{display:block;font:500 10px/1.1 var(--mono);letter-spacing:.16em;color:var(--slate);text-transform:uppercase;margin-top:2px}
.nav ul{display:flex;gap:28px;list-style:none;font:600 13px/1 var(--display);letter-spacing:-.005em}
.nav ul a{position:relative;padding:4px 0;text-transform:uppercase;letter-spacing:.08em;font-size:12px}
.nav ul a::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:2px;background:var(--carbon);transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease)}
.nav ul a:hover::after,.nav ul a.active::after{transform:scaleX(1)}
.nav .cta{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:1.5px solid var(--carbon);border-radius:999px;font:600 12px/1 var(--display);letter-spacing:.08em;text-transform:uppercase;transition:all .25s var(--ease)}
.nav .cta:hover{background:var(--carbon);color:var(--paper)}
.nav .cta .dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(47,158,94,.25)}
@media (max-width:820px){.nav ul{display:none}}

/* ---------- global thread canvas (per-section SVG overlay) ----------
   v2.31 · added opacity gate + transition to fix flicker on browser resize
   and cross-device. Threads start invisible and only appear when both their
   path is computed AND the section is in view (.drawn class). */
.thread-canvas{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1;overflow:visible}
.thread-canvas path{fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:var(--len,4000);stroke-dashoffset:var(--len,4000);opacity:0;transition:stroke-dashoffset 1.6s var(--ease), opacity .5s ease}
.thread-canvas path.drawn{stroke-dashoffset:0;opacity:1}

/* ---------- hero ---------- */
.hero{position:relative;min-height:100vh;padding:120px 28px 40px;overflow:hidden;background:var(--paper)}
.hero .aerial{position:absolute;inset:0;z-index:0;opacity:.22;pointer-events:none}
.hero .aerial svg{width:100%;height:100%}
.hero-grid{position:relative;z-index:2;max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1.3fr .9fr;gap:40px;align-items:start}
@media (max-width:1080px){.hero-grid{grid-template-columns:1fr}}

/* kicker */
.kicker{display:inline-flex;align-items:center;gap:10px;font:500 11px/1 var(--mono);letter-spacing:.22em;color:var(--slate);text-transform:uppercase;padding:8px 12px;border:1px solid rgba(14,14,16,.18);border-radius:999px;background:rgba(244,239,224,.6)}
.kicker .dot{width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 0 3px rgba(221,61,56,.18)}

/* the "NINETY EIGHT" mark */
.mark{margin-top:22px;font-family:var(--display);font-weight:900;line-height:.82;letter-spacing:-.05em;font-size:clamp(58px,11.8vw,196px);white-space:nowrap;max-width:100%}
.mark .row{display:flex;flex-wrap:nowrap;gap:0;white-space:nowrap}
.mark .l{position:relative;display:inline-block;transform:translateY(90%);opacity:0;will-change:transform,opacity}
.mark .l.in{animation:letterIn .95s var(--ease) forwards}
@keyframes letterIn{0%{transform:translateY(90%);opacity:0}60%{transform:translateY(-6%);opacity:1}100%{transform:translateY(0);opacity:1}}
.mark .l .node{position:absolute;left:50%;bottom:6%;width:10px;height:10px;border-radius:50%;background:currentColor;transform:translate(-50%,50%) scale(0);box-shadow:0 0 0 3px var(--paper);opacity:0}
.mark .l.in .node{animation:pop .5s var(--ease) 1.2s forwards}
@keyframes pop{to{transform:translate(-50%,50%) scale(1);opacity:1}}

.mark .row.one .l:nth-child(1){color:var(--royal)}
.mark .row.one .l:nth-child(2){color:var(--red)}
.mark .row.one .l:nth-child(3){color:var(--gold)}
.mark .row.one .l:nth-child(4){color:var(--green)}
.mark .row.one .l:nth-child(5){color:var(--purple)}
.mark .row.one .l:nth-child(6){color:var(--orange)}
.mark .row.two .l:nth-child(1){color:var(--pink)}
.mark .row.two .l:nth-child(2){color:var(--royal)}
.mark .row.two .l:nth-child(3){color:var(--red)}
.mark .row.two .l:nth-child(4){color:var(--green)}
.mark .row.two .l:nth-child(5){color:var(--gold)}

.mark .row.one .l:nth-child(1){animation-delay:.2s}
.mark .row.one .l:nth-child(2){animation-delay:.3s}
.mark .row.one .l:nth-child(3){animation-delay:.4s}
.mark .row.one .l:nth-child(4){animation-delay:.5s}
.mark .row.one .l:nth-child(5){animation-delay:.6s}
.mark .row.one .l:nth-child(6){animation-delay:.7s}
.mark .row.two .l:nth-child(1){animation-delay:.9s}
.mark .row.two .l:nth-child(2){animation-delay:1.0s}
.mark .row.two .l:nth-child(3){animation-delay:1.1s}
.mark .row.two .l:nth-child(4){animation-delay:1.2s}
.mark .row.two .l:nth-child(5){animation-delay:1.3s}

.tagline{margin-top:24px;max-width:620px;font-family:var(--serif);font-style:italic;font-size:clamp(20px,2.1vw,28px);line-height:1.3;color:var(--ink);opacity:0;transform:translateY(20px);transition:opacity .9s var(--ease) 1.8s, transform .9s var(--ease) 1.8s}
.tagline.in{opacity:1;transform:none}
.tagline em{font-style:normal;font-family:var(--display);font-weight:700;letter-spacing:-.01em;background:linear-gradient(180deg,transparent 60%,rgba(245,176,21,.5) 60%);padding:0 4px}

.hero-meta{margin-top:28px;display:flex;gap:28px;flex-wrap:wrap;font:500 12px/1.3 var(--mono);color:var(--slate);letter-spacing:.1em;text-transform:uppercase;opacity:0;transform:translateY(10px);transition:opacity .7s 2.3s, transform .7s 2.3s}
.hero-meta.in{opacity:1;transform:none}
.hero-meta span b{color:var(--carbon);font-weight:600}

/* right column: timeline */
.timeline{position:relative;padding:22px 22px 22px 48px;background:rgba(245,240,225,.75);backdrop-filter:blur(4px);border:1px solid rgba(14,14,16,.08);border-radius:12px}
.timeline::before{content:"";position:absolute;top:24px;bottom:24px;left:20px;width:3px;background:var(--gold);transform-origin:top;animation:growSpine 1.2s var(--ease) 2s both}
@keyframes growSpine{from{transform:scaleY(0)}to{transform:scaleY(1)}}
.timeline h3{font:500 11px/1 var(--mono);letter-spacing:.22em;color:var(--slate);text-transform:uppercase;margin-bottom:14px}
.timeline .quote{font-family:var(--serif);font-style:italic;font-size:20px;line-height:1.4;color:var(--ink);padding:8px 0 18px;border-bottom:1px solid rgba(14,14,16,.08);margin-bottom:16px}
.timeline .quote small{display:block;margin-top:8px;font:500 11px/1 var(--mono);letter-spacing:.12em;color:var(--slate);font-style:normal}
.tl-row{position:relative;padding:10px 0 10px 22px;opacity:0;transform:translateX(8px);transition:opacity .5s, transform .5s}
.tl-row.in{opacity:1;transform:none}
.tl-row::before{content:"";position:absolute;left:-32px;top:14px;width:12px;height:12px;border-radius:50%;background:var(--paper);border:3px solid var(--gold);box-shadow:0 0 0 3px var(--paper)}
.tl-row .yr{font:600 11px/1 var(--mono);letter-spacing:.12em;color:var(--red);text-transform:uppercase}
.tl-row .ev{font:700 15px/1.35 var(--display);margin-top:4px;letter-spacing:-.01em}

/* (3D train + section-breaker styles removed in v2.6) */

/* scroll cue */
.scroll-cue{position:absolute;left:50%;transform:translateX(-50%);bottom:22px;z-index:4;font:500 10px/1 var(--mono);letter-spacing:.3em;color:var(--slate);text-transform:uppercase;display:flex;flex-direction:column;align-items:center;gap:8px}
.scroll-cue .bar{width:1.5px;height:26px;background:var(--slate);animation:bob 1.6s ease-in-out infinite}
@keyframes bob{0%,100%{transform:scaleY(.4);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}}

/* ---------- section shell ---------- */
section{position:relative;padding:120px 28px;z-index:2}
.wrap{max-width:1400px;margin:0 auto;position:relative}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;margin-bottom:52px;flex-wrap:wrap}
.sec-head .lead{max-width:640px}
/* v2.25 · sec-tag styled as a subway-station hanging tile.
   Black bg, white text, down-arrow on the left, colored circle badge on the right.
   Sits ABOVE the section heading like a real subway-station sign. */
.sec-tag{display:inline-flex;align-items:center;gap:14px;font:600 11px/1 var(--mono);letter-spacing:.22em;color:#fff;text-transform:uppercase;margin-bottom:24px;background:var(--carbon);padding:11px 14px 11px 12px;border-radius:6px;box-shadow:0 8px 20px -10px rgba(14,14,16,.35);position:relative}
.sec-tag::before{content:"↓";display:inline-block;font:700 14px/1 var(--display);color:var(--gold);margin-right:-4px}
.sec-tag::after{content:"";position:absolute;top:-12px;left:18%;right:18%;height:12px;background:linear-gradient(to bottom, transparent, transparent 50%, rgba(14,14,16,.18) 50%, rgba(14,14,16,.18) 60%, transparent 60%);background-size:1px 12px;background-repeat:repeat-x;opacity:.7}
.bullet{width:24px;height:24px;border-radius:50%;display:inline-grid;place-items:center;color:#fff;font:800 10px/1 var(--display);letter-spacing:0;flex-shrink:0}
.sec-head h2{font:800 clamp(44px,6vw,80px)/.95 var(--display);letter-spacing:-.035em}
.sec-head h2 em{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--slate)}
.sec-head .note{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--slate);max-width:320px}

.reveal{opacity:0;transform:translateY(20px);transition:opacity .8s var(--ease), transform .8s var(--ease)}
.reveal.in{opacity:1;transform:none}

/* ---------- services ---------- */
#services{background:var(--paper)}
.svc-list{border-top:1.5px solid var(--carbon);position:relative;z-index:3}
.svc-row{display:grid;grid-template-columns:80px 1fr 2.2fr 120px;gap:24px;align-items:center;padding:28px 8px;border-bottom:1.5px solid var(--carbon);position:relative;overflow:hidden;transition:padding .35s var(--ease)}
.svc-row::before{content:"";position:absolute;inset:0;background:var(--carbon);transform:translateY(100%);transition:transform .45s var(--ease);z-index:-1}
.svc-row:hover{padding-left:24px;color:var(--paper)}
.svc-row:hover::before{transform:translateY(0)}
.svc-row .num{font:500 12px/1 var(--mono);letter-spacing:.22em;color:var(--slate)}
.svc-row:hover .num{color:var(--gold)}
.svc-row h3{font:800 clamp(22px,2.6vw,36px)/1 var(--display);letter-spacing:-.02em}
.svc-row p{font:500 14px/1.5 var(--display);color:var(--slate);max-width:520px}
.svc-row:hover p{color:#d8d1ba}
.svc-row .arrow{justify-self:end;font:600 11px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;display:inline-flex;align-items:center;gap:8px;color:var(--slate)}
.svc-row:hover .arrow{color:var(--paper)}
@media (max-width:820px){.svc-row{grid-template-columns:60px 1fr;gap:12px}.svc-row p,.svc-row .arrow{grid-column:1 / -1}}

/* ---------- roster ---------- */
#roster{background:linear-gradient(180deg,var(--paper) 0%,#eee6cf 100%);color:var(--carbon)}
.roster-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;position:relative;z-index:3}
@media (max-width:1080px){.roster-grid{grid-template-columns:1fr}}
.talent-card{display:flex;gap:18px;align-items:flex-start;padding:20px;border:1px solid rgba(14,14,16,.12);border-radius:14px;background:rgba(255,255,255,.45);backdrop-filter:blur(6px);transition:transform .4s var(--ease), box-shadow .4s var(--ease)}
.talent-card:hover{transform:translateY(-4px);box-shadow:0 30px 50px -30px rgba(0,0,0,.25)}
.talent-card .init{width:58px;height:58px;flex:0 0 58px;border-radius:50%;display:grid;place-items:center;color:#fff;font:800 16px/1 var(--display)}
.talent-card h4{font:700 17px/1.1 var(--display);letter-spacing:-.01em}
.talent-card p{font:500 12px/1.5 var(--mono);color:var(--slate);margin-top:4px;letter-spacing:.03em}
.talent-card .tag{display:inline-block;margin-top:6px;margin-right:6px;font:500 10px/1 var(--mono);letter-spacing:.18em;color:var(--slate);text-transform:uppercase;padding:5px 9px;border:1px solid rgba(14,14,16,.15);border-radius:999px}
.talent-col{display:grid;gap:14px}
.brands-col{display:flex;flex-direction:column;gap:14px}
.brands-block{display:grid;grid-template-columns:1fr 1fr;gap:32px;position:relative;z-index:3}
.brands-block h3{font:500 11px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;color:var(--slate);margin-bottom:6px}
@media (max-width:820px){.brands-block{grid-template-columns:1fr}}

/* ---------- v2.10 · WORK SHOWCASE (real Insta highlight covers + placeholders) ---------- */
.work-showcase{position:relative;z-index:3}
.ws-backdrop{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}
.ws-watermark{position:absolute;right:-3vw;top:50%;transform:translateY(-50%);font:900 clamp(280px, 36vw, 520px)/.85 var(--display);color:rgba(14,14,16,.04);letter-spacing:-.06em;user-select:none;pointer-events:none}
.work-showcase > .ws-block{position:relative;z-index:1}
@media (max-width:780px){
  .ws-watermark{font-size:200px;right:-30px}
}
.ws-head{display:flex;align-items:baseline;justify-content:space-between;gap:18px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid rgba(14,14,16,.12)}
.ws-head h3{font:800 clamp(20px,2vw,28px)/1 var(--display);letter-spacing:-.02em;color:var(--carbon)}
.ws-count{font:500 11px/1.4 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--slate);text-align:right}
.bt-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:18px 12px}
.bt{display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:var(--carbon);transition:transform .25s var(--ease)}
.bt:hover{transform:translateY(-3px)}
.bt-img{width:78px;height:78px;border-radius:50%;overflow:hidden;display:grid;place-items:center;background:#0E0E10;color:#fff;font:800 14px/1 var(--display);letter-spacing:-.01em;box-shadow:0 6px 14px -8px rgba(0,0,0,.45),0 0 0 1px rgba(14,14,16,.06) inset;position:relative;transition:box-shadow .3s var(--ease), transform .3s var(--ease)}
.bt:hover .bt-img{box-shadow:0 14px 24px -10px rgba(0,0,0,.55),0 0 0 2px var(--gold) inset}
.bt-img img{width:100%;height:100%;object-fit:cover;display:block}
.bt-name{font:500 11px/1.25 var(--mono);letter-spacing:.05em;color:var(--slate);text-align:center;max-width:100px;text-transform:uppercase;transition:color .25s var(--ease)}
.bt:hover .bt-name{color:var(--carbon)}
.bt.is-placeholder .bt-img{font-size:13px}
@media (max-width:600px){
  .bt-grid{grid-template-columns:repeat(auto-fill,minmax(82px,1fr));gap:14px 10px}
  .bt-img{width:64px;height:64px}
  .bt-name{font-size:10px;max-width:84px}
  .ws-head{flex-direction:column;align-items:flex-start;gap:6px}
  .ws-count{text-align:left}
}
.brand-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.brand-pill{padding:12px 14px;border:1px solid rgba(14,14,16,.18);border-radius:10px;font:700 13px/1.2 var(--display);text-align:center;background:rgba(255,255,255,.55);transition:all .3s var(--ease);letter-spacing:-.005em}
.brand-pill:hover{background:var(--carbon);color:var(--paper);transform:translateY(-2px)}

/* ---------- work ---------- */
#work{background:var(--paper)}
.work-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px;position:relative;z-index:3}
.work-tile{grid-column:span 4;position:relative;overflow:hidden;border-radius:14px;aspect-ratio:4/3;background:var(--carbon);color:var(--paper);padding:22px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .45s var(--ease);isolation:isolate}
.work-tile:hover{transform:translateY(-6px)}
.work-tile::before{content:"";position:absolute;inset:0;z-index:-1;opacity:.9;background:linear-gradient(135deg,var(--c1,var(--royal)) 0%,var(--c2,var(--red)) 100%)}
.work-tile.big{grid-column:span 8;aspect-ratio:16/9}
.work-tile .meta{font:500 10px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;opacity:.85}
.work-tile h3{font:800 clamp(22px,2.4vw,30px)/1.05 var(--display);letter-spacing:-.02em;max-width:80%}
.work-tile .foot{display:flex;justify-content:space-between;align-items:flex-end;font:500 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase}
@media (max-width:980px){.work-tile{grid-column:span 6}.work-tile.big{grid-column:span 12}}
@media (max-width:600px){.work-tile,.work-tile.big{grid-column:span 12}}

/* ---------- culture ---------- */
.culture{background:var(--carbon);color:var(--paper);padding:44px 0;overflow:hidden;position:relative;z-index:2}
.marquee{display:flex;gap:56px;white-space:nowrap;font-family:var(--serif);font-style:italic;font-size:clamp(48px,8vw,120px);line-height:1;letter-spacing:-.02em;color:var(--gold);will-change:transform}
.marquee span{display:inline-flex;align-items:center;gap:56px}
.marquee i{font-family:var(--display);font-style:normal;color:var(--paper);font-weight:900;letter-spacing:-.03em}
.marquee .star{color:var(--red);display:inline-block;transform:translateY(-8px)}

/* ---------- about ---------- */
#about{background:linear-gradient(180deg,var(--paper),#ebe2c8)}
.about-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center;position:relative;z-index:3}
@media (max-width:1080px){.about-grid{grid-template-columns:1fr}}
.founder{display:flex;gap:22px;padding:22px;border:1px solid rgba(14,14,16,.14);border-radius:14px;background:rgba(255,255,255,.5)}
/* v2.31 · 3D ISB / Georgia Tech pins hidden until we land on a treatment that
   reads as part of the founder block (faded, intelligible orbit, not formless).
   Keep the canvas in the DOM so the future treatment can re-enable in CSS only. */
.founder-pin-canvas{display:none;position:absolute;top:-62px;left:-62px;width:220px;height:220px;pointer-events:none;z-index:5}
