/* numbers grid inside slide */
.ic-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:8px 0 20px}
.ic-stat{padding:14px 14px;background:rgba(14,14,16,.06);border:1px solid rgba(14,14,16,.1);border-radius:10px;display:flex;flex-direction:column;gap:2px}
.ic-stat .n{font:800 26px/1 var(--display);letter-spacing:-.02em;color:var(--carbon)}
.ic-stat .l{font:500 10px/1.3 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--slate);margin-top:6px}
.ic-stat .d{font:600 11px/1.3 var(--mono);color:var(--green);margin-top:4px}
.ic-pull{font:600 18px/1.4 var(--display);color:var(--carbon);max-width:46ch;border-left:3px solid var(--gold);padding:6px 0 6px 18px;margin-top:8px;font-style:italic}
.ic-pull em{color:var(--slate)}

/* magnet form */
.ic-form{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;align-items:center;max-width:520px}
.ic-form input{flex:1 1 240px;min-width:0;padding:12px 16px;font:500 14px/1.2 var(--display);background:rgba(255,255,255,.85);border:1.5px solid var(--carbon);border-radius:999px;color:var(--carbon);outline:none}
.ic-form input::placeholder{color:rgba(14,14,16,.45)}
.ic-form input:focus{border-color:var(--royal);box-shadow:0 0 0 3px rgba(31,77,140,.18)}
.ic-form button{padding:12px 20px;font:600 11px/1 var(--mono);letter-spacing:.18em;text-transform:uppercase;background:var(--carbon);color:var(--paper);border:1.5px solid var(--carbon);border-radius:999px;cursor:pointer;transition:all .25s var(--ease)}
.ic-form button:hover{background:var(--paper);color:var(--carbon)}
.ic-form-msg{flex:1 1 100%;font:500 11px/1.3 var(--mono);letter-spacing:.04em;color:var(--carbon);min-height:14px}

/* nav · arrows + dots */
.ic-nav{margin-top:18px;display:flex;align-items:center;justify-content:center;gap:24px}
.ic-nav button{width:42px;height:42px;border-radius:50%;border:1px solid rgba(14,14,16,.2);background:transparent;cursor:pointer;font:400 22px/1 var(--display);color:var(--carbon);display:grid;place-items:center;transition:all .2s var(--ease)}
.ic-nav button:hover:not(:disabled){background:var(--carbon);color:var(--paper);border-color:var(--carbon)}
.ic-nav button:disabled{opacity:.3;cursor:not-allowed}
.ic-dots{display:flex;gap:8px;align-items:center}
.ic-dots .dot{width:8px;height:8px;border-radius:50%;background:rgba(14,14,16,.2);transition:all .3s var(--ease);cursor:pointer;border:none;padding:0}
.ic-dots .dot.active{background:var(--carbon);transform:scale(1.3)}
.ic-longform{margin-top:14px;text-align:center}
.ic-longform a{font:500 11px/1.3 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--slate);text-decoration:underline;text-decoration-color:rgba(14,14,16,.2);text-underline-offset:6px;transition:color .25s var(--ease)}
.ic-longform a:hover{color:var(--carbon);text-decoration-color:var(--carbon)}

/* v2.18 · TRAIN STRIP — divider between sections.
   v2.31 · bigger train, tighter surroundings, bottom-anchored. Strip is just
   tall enough to hold the train; less empty whitespace above. */
.train-strip{position:relative;background:transparent;height:480px;overflow:hidden}
.train-strip-tag{position:absolute;top:14px;left:28px;font:500 11px/1 var(--mono);letter-spacing:.26em;text-transform:uppercase;color:var(--slate);z-index:3;display:inline-flex;align-items:center;gap:10px}
.train-strip-tag::before{content:"";width:30px;height:1px;background:var(--carbon)}
/* v2.33 · Bigger again, tighter strip — train sits flush at the bottom edge. */
.train-img{position:absolute;bottom:-8px;height:680px;width:auto;will-change:left;z-index:2;filter:drop-shadow(0 36px 46px rgba(14,14,16,.18));left:50vw;transition:left .15s linear}
/* Auto-loop fallback if JS scroll-drive hasn't initialised */
.train-strip:not([data-scroll-driven]) .train-img{
  animation: train-pass 36s linear infinite;
  transition: none;
}
@keyframes train-pass{
  0%   { left: 100vw; }
  100% { left: -2400px; }
}
@media (prefers-reduced-motion: reduce){
  .train-img{animation:none;transition:none;left:50%;bottom:-8px}
}
@media (max-width:980px){
  .train-strip{height:380px}
  .train-img{height:520px;bottom:-8px}
}
@media (max-width:780px){
  .train-strip{height:260px}
  .train-img{height:360px;bottom:-6px}
  .train-strip-tag{font-size:9px;letter-spacing:.18em;left:18px;top:12px}
}

/* v2.20 · PULLABLE THREADS — clicking a section heading "twangs" the
   colored threads emanating from the logo through that section. */
.thread-canvas{transition: transform .15s ease}
.thread-canvas.threads-twang{animation: thread-twang .9s cubic-bezier(.36,.07,.19,.97)}
@keyframes thread-twang{
  0%   { transform: translateX(0) }
  10%  { transform: translateX(-4px) }
  20%  { transform: translateX(5px) }
  30%  { transform: translateX(-4px) }
  40%  { transform: translateX(3px) }
  50%  { transform: translateX(-2px) }
  60%  { transform: translateX(1.5px) }
  70%  { transform: translateX(-1px) }
  80%  { transform: translateX(0.5px) }
  100% { transform: translateX(0) }
}
.sec-head h2,
.timeline h3,
.terminus h2{cursor:pointer;user-select:none}
.sec-head h2::after,
.timeline h3::after{
  content: "↯ pull";
  display:inline-block;
  margin-left:14px;
  font:500 9px/1 var(--mono);
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--slate);
  opacity:0;
  transform:translateY(2px);
  transition: opacity .25s ease, transform .25s ease;
  vertical-align: middle;
}
.sec-head h2:hover::after,
.timeline h3:hover::after{opacity:.6;transform:translateY(0)}

/* v2.22 · MANIFESTO removed entirely (CSS kept commented for restoration if ever needed). */

/* v2.16 · Terminus tag + subway-ticket reveal on the magnet slide */
.ic-terminus-tag{font:600 10px/1 var(--mono);letter-spacing:.28em;text-transform:uppercase;color:var(--carbon);display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid var(--carbon);border-radius:999px;background:rgba(14,14,16,.06);margin-bottom:18px;align-self:flex-start;animation:ic-tag-in .8s var(--ease) both}
.ic-terminus-tag .ict-bullet{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 0 0 rgba(221,61,56,.6);animation:ic-pulse 1.6s var(--ease) infinite}
@keyframes ic-tag-in{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
@keyframes ic-pulse{0%,100%{box-shadow:0 0 0 0 rgba(221,61,56,.6)}50%{box-shadow:0 0 0 8px rgba(221,61,56,0)}}

.ic-magnet-slide .ic-form.ic-form-out{opacity:0;transform:translateY(6px);transition:opacity .25s var(--ease), transform .25s var(--ease);pointer-events:none}

.ic-ticket{margin-top:8px;animation:ic-ticket-in .9s var(--ease) both}
.ic-ticket-card{position:relative;background:var(--paper);color:var(--carbon);border:1px solid var(--carbon);border-radius:10px;padding:22px 24px 22px;max-width:520px;box-shadow:0 30px 60px -28px rgba(0,0,0,.45);overflow:hidden}
.ic-ticket-card::before,.ic-ticket-card::after{content:"";position:absolute;top:50%;width:14px;height:14px;border-radius:50%;background:var(--gold);transform:translateY(-50%)}
.ic-ticket-card::before{left:-7px}
.ic-ticket-card::after{right:-7px}
.ic-ticket-stamp{position:absolute;top:18px;right:24px;transform:rotate(8deg);padding:6px 12px;border:2px solid var(--red);color:var(--red);font:800 11px/1 var(--display);letter-spacing:.18em;border-radius:4px;text-transform:uppercase;animation:ic-stamp-in .6s .35s cubic-bezier(.34,1.56,.64,1) both;opacity:0;transform-origin:center}
.ic-ticket-row{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:14px}
.ic-ticket-label{font:500 10px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;color:var(--slate)}
.ic-ticket-line{display:inline-flex;gap:4px}
.ictl-dot{width:8px;height:8px;border-radius:50%}
.ic-ticket-headline{font:800 24px/1.1 var(--display);letter-spacing:-.02em;margin:6px 0 16px}
.ic-ticket-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;border-top:1px dashed rgba(14,14,16,.18);border-bottom:1px dashed rgba(14,14,16,.18);padding:12px 0;margin-bottom:14px}
.ic-ticket-fields > div{display:flex;flex-direction:column;gap:2px}
.ic-ticket-fields small{font:500 9px/1 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--slate)}
.ic-ticket-fields span{font:600 13px/1.2 var(--display);color:var(--carbon)}
.ic-ticket-fields .ic-ticket-email{font-family:var(--mono);font-size:12px}
.ic-ticket-perf{height:1px;border-top:1px dotted rgba(14,14,16,.25);margin:0 -24px 12px}
.ic-ticket-note{font:500 12px/1.5 var(--display);color:var(--slate);max-width:42ch}
.ic-ticket-note em{color:var(--carbon);font-style:normal;font-weight:600}
@keyframes ic-ticket-in{from{opacity:0;transform:translateY(14px) rotate(-1deg)}to{opacity:1;transform:none}}
@keyframes ic-stamp-in{0%{opacity:0;transform:rotate(8deg) scale(2.2)}100%{opacity:1;transform:rotate(8deg) scale(1)}}

@media (max-width:780px){
  .ic-slide{flex-basis:calc(100vw - 44px);min-height:520px}
  .ic-slide .ic-text{max-width:100%;padding:28px 26px}
  .ic-stats{grid-template-columns:repeat(2,1fr)}
  .ic-slide h3{font-size:32px}
}

/* v2.15 · SCROLL LOCK — Apple-style pin & advance
   v2.31 · cricket-ball animation removed (scrolled the wrong way). Just the
   threads and the carousel now — clean. */
.scroll-lock-wrapper{position:relative}
.scroll-lock-sticky{position:relative}
.ishant-carousel{position:relative;z-index:2}
#our-people .thread-canvas{opacity:.32}
.scroll-lock-skip{display:none}
@media (min-width:1080px) and (prefers-reduced-motion: no-preference){
  .scroll-lock-wrapper.scroll-lock-active{height:600vh}
  .scroll-lock-wrapper.scroll-lock-active .scroll-lock-sticky{
    position:sticky;top:78px;height:calc(100vh - 78px);
    display:flex;flex-direction:column;justify-content:center;
  }
  .scroll-lock-wrapper.scroll-lock-active .ic-rail{
    scroll-snap-type:none;scroll-behavior:auto;
    overflow:hidden;pointer-events:none;
  }
  .scroll-lock-wrapper.scroll-lock-active .ic-nav,
  .scroll-lock-wrapper.scroll-lock-active .ic-longform{pointer-events:auto}
  /* progress chip — visible only in scroll-lock mode */
  .scroll-lock-wrapper.scroll-lock-active .scroll-lock-skip{
    display:flex;position:absolute;top:14px;right:14px;z-index:5;
    align-items:center;gap:10px;padding:8px 14px;border-radius:999px;
    background:rgba(14,14,16,.78);color:var(--paper);
    font:500 10px/1 var(--mono);letter-spacing:.2em;text-transform:uppercase;
    backdrop-filter:blur(8px);border:1px solid rgba(244,239,224,.2);
    cursor:pointer;text-decoration:none;transition:all .25s var(--ease);
  }
  .scroll-lock-wrapper.scroll-lock-active .scroll-lock-skip:hover{background:var(--carbon)}
  .scroll-lock-wrapper.scroll-lock-active .scroll-lock-skip .slp{
    width:80px;height:3px;background:rgba(244,239,224,.2);border-radius:2px;overflow:hidden;
  }
  .scroll-lock-wrapper.scroll-lock-active .scroll-lock-skip .slp::after{
    content:"";display:block;height:100%;width:var(--lock-progress,0%);
    background:var(--gold);transition:width .15s linear;
  }
}

/* ============================================================
   v2.14b · Featured Cases — bigger tiles per request
   ============================================================ */
.featured-cases .fc-grid{grid-template-columns:repeat(2,1fr);gap:24px}
.featured-cases .fc-card .fc-cover{height:240px}
.featured-cases .fc-card .fc-cover.is-text .fc-mark{font-size:54px}
.featured-cases .fc-card .fc-name{font-size:clamp(24px,2.4vw,30px)}
.featured-cases .fc-card .fc-body{padding:24px 26px 26px}
.featured-cases .fc-card .fc-teaser{font-size:14.5px}
@media (max-width:780px){
  .featured-cases .fc-grid{grid-template-columns:1fr;gap:18px}
  .featured-cases .fc-card .fc-cover{height:200px}
}

/* ============================================================
   v2.13 · CASE DIALOG — reusable case-study modal system
   Pattern reused by every Tier 1 case (Ishant first; Slay,
   YYC, Andreas, Ophelia, Rooh, Khubani, Arista Vault to follow).
   ============================================================ */
/* v2.29 · case-dialog matched to founder-dialog look — same dimensions, padding, frame.
   Editorial Vignelli-tribute spread, just for case studies. */
.case-dialog{border:none;padding:0;width:calc(100% - 36px);max-width:1040px;max-height:92vh;border-radius:6px;background:var(--paper);color:var(--carbon);box-shadow:0 40px 100px -20px rgba(0,0,0,.55), 0 0 0 1px rgba(14,14,16,.08);overflow:hidden;margin:auto;inset:0}
.case-dialog::backdrop{background:rgba(14,14,16,.72);backdrop-filter:blur(6px)}
.case-dialog .cd-head{position:sticky;top:0;display:flex;justify-content:space-between;align-items:center;padding:16px 28px;background:var(--paper);border-bottom:1px solid rgba(14,14,16,.1);z-index:5}
.case-dialog .cd-tag{font:500 10px/1 var(--mono);letter-spacing:.24em;text-transform:uppercase;color:var(--slate);display:flex;align-items:center;gap:8px}
.case-dialog .cd-tag::before{content:"";width:18px;height:1px;background:var(--royal)}
.case-dialog .cd-close{width:34px;height:34px;border-radius:50%;border:1px solid rgba(14,14,16,.18);background:transparent;cursor:pointer;font:400 22px/1 var(--display);color:var(--carbon);display:grid;place-items:center;transition:all .2s var(--ease)}
.case-dialog .cd-close:hover{background:var(--carbon);color:var(--paper);border-color:var(--carbon)}
.case-dialog .cd-body{overflow-y:auto;max-height:calc(92vh - 60px)}

/* v2.29 · COLLAGE HERO — replaces single-portrait covers with a collage of
   creator circles (bg-removed PNGs at varied scales when available). On a
   dark gradient base; reads as a magazine cover. */
.cd-hero-collage{position:relative;overflow:hidden;aspect-ratio:5/3;min-height:340px;max-height:60vh;display:flex;align-items:flex-end;background:linear-gradient(135deg,#1f4d8c 0%,#0e0e10 50%,#dd3d38 100%)}
.cd-hero-collage::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 30% 70%,rgba(245,176,21,.18) 0%,transparent 60%);z-index:1;pointer-events:none}
.cdh-creator{position:absolute;z-index:2;display:grid;place-items:center;border-radius:50%;aspect-ratio:1;color:#fff;font:600 10px/1.2 var(--mono);letter-spacing:.04em;text-align:center;padding:10%;box-shadow:0 12px 24px -8px rgba(0,0,0,.45),0 0 0 2px rgba(244,239,224,.15) inset;transition:transform .5s var(--ease);overflow:hidden}
.cdh-creator img{width:100%;height:100%;object-fit:cover;display:block;border-radius:50%}
.cdh-creator:hover{transform:translateY(-6px) scale(1.04)}
.cd-hero-collage .cd-hero-text{position:relative;z-index:3;padding:32px 36px;color:#fff;max-width:62%;background:linear-gradient(to right,rgba(14,14,16,.8) 0%,rgba(14,14,16,.4) 80%,transparent 100%)}

/* Hero · banner with cut-out talent on color bg (existing pattern, used by Ishant) */
.cd-hero{position:relative;background:var(--royal);overflow:hidden;aspect-ratio:5/3;min-height:280px;max-height:60vh;display:flex;align-items:flex-end}
.cd-hero img{position:absolute;right:0;top:0;bottom:0;height:100%;width:auto;max-width:60%;object-fit:contain;object-position:right bottom;display:block}
.cd-hero .cd-hero-text{position:relative;z-index:2;padding:36px 36px 32px;color:#fff;max-width:60%}
.cd-hero .cd-hero-meta{font:500 11px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.85);margin-bottom:14px;display:flex;align-items:center;gap:10px}
.cd-hero .cd-hero-meta::before{content:"";width:24px;height:1px;background:#fff}
.cd-hero h2{font:800 clamp(32px,4vw,56px)/1 var(--display);letter-spacing:-.03em;color:#fff;margin-bottom:10px}
.cd-hero .cd-hero-sub{font:500 14.5px/1.45 var(--display);color:rgba(255,255,255,.92);max-width:46ch}

/* Chapter rhythm */
.cd-chapter{padding:42px 36px 0;max-width:760px;margin:0 auto}
.cd-chapter:last-of-type{padding-bottom:36px}
.cd-chapter h3{font:800 22px/1.2 var(--display);letter-spacing:-.02em;color:var(--carbon);margin-bottom:14px;display:flex;align-items:center;gap:12px}
.cd-chapter h3 .cd-num{font:600 10px/1 var(--mono);letter-spacing:.2em;color:var(--slate);background:rgba(14,14,16,.06);padding:6px 10px;border-radius:6px;flex-shrink:0}
.cd-chapter h3 .cd-bullet{width:10px;height:10px;border-radius:50%;flex:0 0 10px}
.cd-chapter p{font:500 15px/1.65 var(--display);color:var(--ink);margin-bottom:14px;max-width:64ch}
.cd-chapter p.cd-lead{font-size:16px;color:var(--carbon);font-weight:500}
.cd-chapter .cd-pull{font:600 18px/1.45 var(--display);color:var(--carbon);max-width:50ch;border-left:3px solid var(--gold);padding:6px 0 6px 18px;margin:18px 0;font-style:italic}

/* Stats grid · the receipts */
.cd-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:18px 0 8px}
.cd-stat{padding:18px 18px;background:rgba(255,255,255,.55);border:1px solid rgba(14,14,16,.12);border-radius:10px;display:flex;flex-direction:column;gap:4px}
.cd-stat .n{font:800 26px/1 var(--display);letter-spacing:-.02em;color:var(--carbon)}
.cd-stat .l{font:500 10px/1.3 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--slate);margin-top:6px}
.cd-stat .d{font:600 11px/1.3 var(--mono);color:var(--green);margin-top:4px}

/* Press citation */
.cd-cite{display:flex;align-items:center;gap:14px;padding:14px 16px;background:rgba(14,14,16,.04);border:1px solid rgba(14,14,16,.08);border-radius:8px;margin:14px 0;font:500 12.5px/1.5 var(--mono);color:var(--slate)}
.cd-cite a{color:var(--royal);text-decoration:underline;font-weight:600}

/* Mid-modal hero divider · scene break */
.cd-divider{margin:32px 0 0;width:100%;aspect-ratio:5/2;background:var(--green);overflow:hidden;position:relative}
.cd-divider img{position:absolute;right:8%;bottom:0;height:130%;width:auto;object-fit:contain;display:block}

/* Sister-case link · Arista Vault */
.cd-sister{margin:18px 0 4px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 20px;background:var(--carbon);color:var(--paper);border-radius:10px;text-decoration:none;transition:transform .2s var(--ease)}
.cd-sister:hover{transform:translateX(3px)}
.cd-sister .cd-sister-label{font:500 10px/1.2 var(--mono);letter-spacing:.22em;text-transform:uppercase;color:rgba(244,239,224,.65);margin-bottom:4px;display:block}
.cd-sister .cd-sister-name{font:800 18px/1.1 var(--display);letter-spacing:-.01em}
.cd-sister .cd-sister-arrow{font:400 22px/1 var(--display);opacity:.8}

/* Closing hero · "End of the line" */
/* v2.29 · MAGNET FORM at end of every case modal — newsletter / consultation funnel */
.cd-magnet{margin-top:24px;display:flex;flex-direction:column;gap:10px;align-items:center;max-width:540px;margin-left:auto;margin-right:auto}
.cd-magnet form{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;width:100%}
.cd-magnet input{flex:1 1 240px;min-width:0;padding:12px 18px;font:500 14px/1.2 var(--display);background:rgba(244,239,224,.08);border:1.5px solid rgba(244,239,224,.32);border-radius:999px;color:var(--paper);outline:none;transition:all .25s var(--ease)}
.cd-magnet input::placeholder{color:rgba(244,239,224,.45)}
.cd-magnet input:focus{border-color:var(--gold);background:rgba(244,239,224,.14)}
.cd-magnet button{padding:12px 22px;font:600 11px/1 var(--mono);letter-spacing:.2em;text-transform:uppercase;background:var(--gold);color:var(--carbon);border:1.5px solid var(--gold);border-radius:999px;cursor:pointer;transition:all .25s var(--ease)}
.cd-magnet button:hover{background:transparent;color:var(--gold)}
.cd-magnet button:disabled{opacity:.5;cursor:not-allowed}
.cd-magnet-alt{font:500 11px/1.4 var(--mono);letter-spacing:.04em;color:rgba(244,239,224,.62);margin-top:4px}
.cd-magnet-alt a{color:var(--gold);text-decoration:underline;text-underline-offset:3px}
.cd-magnet-msg{font:500 11px/1.4 var(--mono);color:var(--gold);min-height:14px;text-align:center}

.cd-close-hero{margin-top:40px;padding:48px 36px 56px;background:var(--carbon);color:var(--paper);text-align:center;position:relative;overflow:hidden}
.cd-close-hero::before{content:"";position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(to right,var(--royal),var(--gold),var(--red),var(--green))}
.cd-close-hero .cd-close-tag{font:500 10px/1 var(--mono);letter-spacing:.24em;text-transform:uppercase;color:rgba(244,239,224,.6);margin-bottom:14px;display:block}
.cd-close-hero h4{font:800 clamp(20px,2.4vw,28px)/1.25 var(--display);letter-spacing:-.02em;max-width:36ch;margin:0 auto 14px;color:#fff}
.cd-close-hero p{font:500 13px/1.55 var(--mono);letter-spacing:.04em;color:rgba(244,239,224,.75);max-width:50ch;margin:0 auto}

/* Roster cards become clickable cases · cursor + subtle lift */
.roster-slide[data-case]{cursor:pointer}
.roster-slide[data-case]:hover{transform:translateY(-2px);transition:transform .25s var(--ease)}
.roster-slide[data-case]:focus-visible{outline:2px solid var(--royal);outline-offset:4px}

@media (max-width:680px){
  .case-dialog{width:calc(100% - 16px);max-height:96vh}
  .cd-hero{aspect-ratio:4/3}
  .cd-hero .cd-hero-text{max-width:100%;padding:24px 22px}
  .cd-chapter{padding:32px 22px 0}
