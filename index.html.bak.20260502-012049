  }
  function syncState(){
    const i = activeIndex();
    dotEls.forEach((d, di) => d.classList.toggle('active', di === i));
    prev.disabled = i === 0;
    next.disabled = i === slides.length - 1;
  }
  function goTo(i){
    i = Math.max(0, Math.min(slides.length - 1, i));
    const target = slides[i];
    const railRect = rail.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();
    const delta = (targetRect.left + targetRect.width/2) - (railRect.left + railRect.width/2);
    rail.scrollBy({left: delta, behavior: 'smooth'});
  }
  // Scroll-lock-aware navigation. When .scroll-lock-active is on the wrapper,
  // prev/next scroll the page (which advances the locked rail); otherwise
  // they scroll the rail directly.
  function pageJump(direction){
    const wrapper = document.getElementById('ishant-scroll-lock');
    if (!wrapper) return false;
    if (!wrapper.classList.contains('scroll-lock-active')) return false;
    const stepPx = (wrapper.offsetHeight - window.innerHeight) / (slides.length - 1);
    window.scrollBy({top: direction * stepPx, behavior:'smooth'});
    return true;
  }
  function jumpToSlide(i){
    const wrapper = document.getElementById('ishant-scroll-lock');
    if (!wrapper || !wrapper.classList.contains('scroll-lock-active')) {
      goTo(i);
      return;
    }
    const wrapperTop = wrapper.getBoundingClientRect().top + window.scrollY;
    const total = wrapper.offsetHeight - window.innerHeight;
    const targetY = wrapperTop + (i / (slides.length - 1)) * total;
    window.scrollTo({top: targetY, behavior:'smooth'});
  }
  prev.addEventListener('click', () => { if (!pageJump(-1)) goTo(activeIndex() - 1); });
  next.addEventListener('click', () => { if (!pageJump( 1)) goTo(activeIndex() + 1); });
  dotEls.forEach(d => d.addEventListener('click', () => jumpToSlide(+d.dataset.i)));
  rail.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') { e.preventDefault(); if (!pageJump( 1)) goTo(activeIndex() + 1); }
    if (e.key === 'ArrowLeft')  { e.preventDefault(); if (!pageJump(-1)) goTo(activeIndex() - 1); }
  });
  let q = false;
  rail.addEventListener('scroll', () => {
    if (q) return;
    q = true;
    requestAnimationFrame(() => { q = false; syncState(); });
  }, {passive:true});
  syncState();
})();

/* ============================================================
   5c. v2.15 · ISHANT SCROLL-LOCK (Apple-style pin & advance)
   Pins the carousel and converts vertical scroll into horizontal
   slide advance. Only on ≥1080px viewports with no reduced-motion
   preference — mobile + a11y users still get native swipe.
   ============================================================ */

/* v2.31 · cricket-ball animation removed — direction was scrolling the
   wrong way for the Ishant carousel. Threads stay; the ball is gone. */

(function initIshantScrollLock(){
  const wrapper = document.getElementById('ishant-scroll-lock');
  const rail    = document.getElementById('ic-rail');
  if (!wrapper || !rail) return;

  const slides = rail.querySelectorAll('.ic-slide');
  if (slides.length < 2) return;

  const mqW = window.matchMedia('(min-width: 1080px)');
  const mqM = window.matchMedia('(prefers-reduced-motion: reduce)');

  let active = false;
  let scheduled = false;

  function setProgress(p){
    wrapper.style.setProperty('--lock-progress', (p * 100).toFixed(2) + '%');
  }
  function update(){
    if (!active) return;
    const rect = wrapper.getBoundingClientRect();
    const wrapperHeight = wrapper.offsetHeight;
    const viewport = window.innerHeight;
    const total = wrapperHeight - viewport;
    if (total <= 0) return;
    const scrolled = Math.max(0, Math.min(total, -rect.top));
    const progress = scrolled / total;
    const railMax = rail.scrollWidth - rail.clientWidth;
    rail.scrollLeft = progress * railMax;
    setProgress(progress);
  }
  function onScroll(){
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => { scheduled = false; update(); });
  }
  function activate(){
    if (active) return;
    active = true;
    wrapper.classList.add('scroll-lock-active');
    window.addEventListener('scroll', onScroll, {passive:true});
    update();
  }
  function deactivate(){
    if (!active) return;
    active = false;
    wrapper.classList.remove('scroll-lock-active');
    window.removeEventListener('scroll', onScroll);
    rail.scrollLeft = 0;
    setProgress(0);
  }
  function evaluate(){
    if (mqW.matches && !mqM.matches) activate();
    else deactivate();
  }

  evaluate();
  // Re-evaluate on viewport changes
  if (mqW.addEventListener) {
    mqW.addEventListener('change', evaluate);
    mqM.addEventListener('change', evaluate);
  } else if (mqW.addListener) {
    mqW.addListener(evaluate);
    mqM.addListener(evaluate);
  }
  window.addEventListener('resize', () => { if (active) update(); }, {passive:true});
})();

