/* v2.23 · cut-out portraits — right-anchored, vertically centered, contain (preserve full figure) */
.ic-slide .ic-portrait{position:absolute;right:0;bottom:0;top:0;height:100%;width:auto;max-width:55%;object-fit:contain;object-position:right bottom;display:block;z-index:1}
