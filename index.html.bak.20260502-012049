/* ============================================================
   5f. v2.22 · FOUNDER PINS — Three.js floating GLBs
   v2.24 · Both ISB and Georgia Tech pins, diagonal placement
   around the avatar with independent rotation + bobbing phases.
   Lazy-loads Three.js + GLTFLoader from CDN. Graceful fallback:
   if either GLB is missing, that pin just doesn't appear; if
   neither loads, the canvas hides itself.
   ============================================================ */

(function initFounderPin(){
  const canvas = document.getElementById('founder-pin-canvas');
  if (!canvas) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    canvas.style.display = 'none';
    return;
  }

  function loadScript(src){
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = resolve;
      s.onerror = () => reject(new Error('failed: ' + src));
      document.head.appendChild(s);
    });
  }

  (async () => {
    try {
      if (typeof THREE === 'undefined'){
        await loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js');
      }
      if (typeof THREE.GLTFLoader === 'undefined'){
        await loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js');
      }
    } catch (err){
      console.warn('[founder-pin] three.js failed to load — hiding canvas', err);
      canvas.style.display = 'none';
      return;
    }

    const W = 220, H = 220;
    canvas.width = W * (window.devicePixelRatio || 1);
    canvas.height = H * (window.devicePixelRatio || 1);
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, W/H, 0.1, 100);
    camera.position.set(0, 0, 4.2);

    const renderer = new THREE.WebGLRenderer({canvas, alpha:true, antialias:true});
    renderer.setSize(W, H, false);
    renderer.setPixelRatio(window.devicePixelRatio || 1);
    renderer.setClearColor(0x000000, 0); // transparent — no dark box

    scene.add(new THREE.AmbientLight(0xffffff, 0.75));
    const key = new THREE.DirectionalLight(0xffffff, 0.7);
    key.position.set(2, 3, 4);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xfff7d6, 0.45);
    rim.position.set(-3, 1, -2);
    scene.add(rim);

    // Two pins, diagonal: ISB top-right, Georgia Tech bottom-left.
    const pinDefs = [
      { src: 'highlights/founder/isb-pin.glb',    baseX:  1.25, baseY:  0.95, phase: 0,             targetSize: 0.95 },
      { src: 'highlights/founder/gatech-pin.glb', baseX: -1.25, baseY: -0.95, phase: Math.PI * 0.7,  targetSize: 0.95 }
    ];

    const pins = [];
    let loadedCount = 0;
    const loader = new THREE.GLTFLoader();

    pinDefs.forEach(def => {
      loader.load(
        def.src,
        (gltf) => {
          // wrap pin in a Group so we can recenter the geometry inside it
          // and orbit/rotate the GROUP without losing the recenter offset.
          const inner = gltf.scene;
          const box = new THREE.Box3().setFromObject(inner);
          const size = box.getSize(new THREE.Vector3());
          const maxDim = Math.max(size.x, size.y, size.z) || 1;
          const scale = def.targetSize / maxDim;
          inner.scale.setScalar(scale);
          // recompute box AFTER scaling (more reliable)
          const box2 = new THREE.Box3().setFromObject(inner);
          const center = box2.getCenter(new THREE.Vector3());
          inner.position.sub(center); // now inner is centered at origin

          const pin = new THREE.Group();
          pin.add(inner);
          pin.userData.baseX = def.baseX;
          pin.userData.baseY = def.baseY;
          pin.userData.phase = def.phase;
          scene.add(pin);
          pins.push(pin);
          loadedCount++;
          console.log('[founder-pin] loaded', def.src, 'scale', scale.toFixed(2));
        },
        undefined,
        (err) => {
          console.warn('[founder-pin] failed to load', def.src, err);
          if (loadedCount === 0 && pins.length === 0){
            setTimeout(() => { if (pins.length === 0) canvas.style.display = 'none'; }, 600);
          }
        }
      );
    });

    let t = 0;
    function tick(){
      t += 0.012;
      pins.forEach(pin => {
        const ph = pin.userData.phase || 0;
        pin.rotation.y = t * 0.55 + ph;
        pin.rotation.x = Math.sin(t * 0.5 + ph) * 0.16;
        pin.position.x = pin.userData.baseX + Math.cos(t * 0.7 + ph) * 0.07;
        pin.position.y = pin.userData.baseY + Math.sin(t + ph) * 0.09;
      });
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    }
    tick();
  })();
})();

