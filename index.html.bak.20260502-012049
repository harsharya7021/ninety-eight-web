/* ============================================================
   5d. v2.20 · TRAIN — scroll-driven motion
   The strip has a long visible window. As the user scrolls past
   it, the train's left position is mapped from scroll progress —
   so direction follows scroll, speed follows scroll velocity.
   Auto-loop kept as CSS fallback if JS doesn't init in time.
   ============================================================ */

(function initTrainScrollDrive(){
  const strip = document.getElementById('train-strip');
  if (!strip) return;
  const train = strip.querySelector('.train-img');
  if (!train) return;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  // Mark the strip — CSS rule disables the auto-loop animation when this attr is present
  strip.setAttribute('data-scroll-driven', 'true');

  let scheduled = false;
  function update(){
    const rect = strip.getBoundingClientRect();
    const vh = window.innerHeight;
    // v2.25 · slow + extended: tracking window covers strip + 150% of next viewport,
    // so the train keeps moving after the strip has exited and only fully clears the
    // screen once the next section is well into view.
    const extra = vh * 1.5;
    const windowH = vh + rect.height + extra;
    const currentDist = vh - rect.top;
    const progress = Math.max(0, Math.min(1, currentDist / windowH));
    const startX = window.innerWidth + 600;   // longer entrance ramp
    const endX   = -2600;                     // longer exit ramp
    const x = startX + (endX - startX) * progress;
    train.style.left = x + 'px';
  }

  window.addEventListener('scroll', () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => { scheduled = false; update(); });
  }, {passive: true});
  window.addEventListener('resize', update, {passive: true});

  update();
})();

