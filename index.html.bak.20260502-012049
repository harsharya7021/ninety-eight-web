    x -= speed;
    if(Math.abs(x) > inner.offsetWidth) x = 0;
    m.style.transform = `translateX(${x}px)`;
    requestAnimationFrame(tick);
  })();
})();

/* ============================================================
   2. HERO THREADS · LINES FROM EACH LETTER
   Each colored strand originates at a letter's bottom-centre,
   sweeps through each section's SVG, with gaps where we want
   the thread "hidden", and re-emerges later. Drawn on scroll.
   ============================================================ */

const COLORS = [
  getComputedStyle(document.documentElement).getPropertyValue('--royal').trim(),
  getComputedStyle(document.documentElement).getPropertyValue('--red').trim(),
  getComputedStyle(document.documentElement).getPropertyValue('--gold').trim(),
  getComputedStyle(document.documentElement).getPropertyValue('--green').trim(),
  getComputedStyle(document.documentElement).getPropertyValue('--purple').trim(),
  getComputedStyle(document.documentElement).getPropertyValue('--orange').trim()
];

function buildThreads(){
  const scroll = window.scrollY || document.documentElement.scrollTop;
  const origins = Array.from(document.querySelectorAll('.mark .l'))
    .slice(0,6)
    .map(n=>{
      const r = n.getBoundingClientRect();
      return { x: r.left + r.width/2, y: r.bottom + scroll - 4 };
    });

  const sections = [
    { el: document.querySelector('.hero'),         svg: document.getElementById('thread-hero'),       vis:'solid' },
    { el: document.getElementById('our-people'),   svg: document.getElementById('thread-our-people'), vis:'solid' },
    { el: document.getElementById('services'),     svg: document.getElementById('thread-services'),   vis:'solid' },
    { el: document.getElementById('about'),        svg: document.getElementById('thread-about'),      vis:'ghost' }
  ];

  let carry = origins.slice();

  sections.forEach((s, si)=>{
    if(!s.el || !s.svg) return;
    const r = s.el.getBoundingClientRect();
    const w = document.documentElement.clientWidth;
    const h = s.el.offsetHeight;
    s.svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    s.svg.style.width = w + 'px';
    s.svg.style.height = h + 'px';
    s.svg.innerHTML = '';

    const sectionTop = r.top + scroll;
    const next = [];

    for(let i=0;i<6;i++){
      const startAbs = carry[i];
      const sx = startAbs.x;
      const sy = Math.max(0, startAbs.y - sectionTop);

      // spread end-points with a wobble, not uniformly
      const spread = (i + 0.5) / 6;
      const endX = 80 + (w - 160) * spread + Math.sin(si*1.3 + i*0.9)*60;
      const endY = h;

      const c1x = sx + Math.sin(i + si*0.7)*160;
      const c1y = sy + h*0.28;
      const c2x = endX + Math.cos(i + si*0.9)*140;
      const c2y = sy + h*0.72;

      const path = document.createElementNS('http://www.w3.org/2000/svg','path');
      path.setAttribute('d', `M ${sx} ${sy} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${endX} ${endY}`);
      path.setAttribute('stroke', COLORS[i]);
      path.setAttribute('opacity', s.vis === 'ghost' ? '0.10' : '0.55');
      if(s.vis === 'ghost'){ path.setAttribute('stroke-dasharray', '2 10'); }

      const len = path.getTotalLength ? path.getTotalLength() : 4000;
      if(s.vis !== 'ghost') path.style.setProperty('--len', len);
      s.svg.appendChild(path);
      next.push({ x: endX, y: sectionTop + endY });
    }
    carry = next;
  });

}

window.addEventListener('load', ()=>{
  // wait for font + layout
  setTimeout(()=>{
    buildThreads();
    // reveal hero threads immediately
    document.querySelectorAll('#thread-hero path').forEach((p,i)=>{
      setTimeout(()=>p.classList.add('drawn'), 400 + i*120);
    });
    // reveal other sections when they come into view
    const tObs = new IntersectionObserver((en)=>{
      en.forEach(e=>{
        if(e.isIntersecting){
          const svgs = e.target.querySelectorAll('.thread-canvas path');
          svgs.forEach((p,i)=>setTimeout(()=>p.classList.add('drawn'), i*110));
          tObs.unobserve(e.target);
        }
      });
    }, {threshold:.2});
    document.querySelectorAll('section, footer').forEach(s=>tObs.observe(s));
  }, 700);
});
let rsT;
window.addEventListener('resize', ()=>{ clearTimeout(rsT); rsT = setTimeout(()=>{
  buildThreads();
  document.querySelectorAll('.thread-canvas path').forEach(p=>p.classList.add('drawn'));
}, 220); });

/* (Three.js train initialisation removed in v2.6) */

/* ============================================================
   3. v2.7 · STATION CHIP + STATION RAIL
   Both fed by the existing nav IntersectionObserver above.
   ============================================================ */

const stopMeta = {
  'our-people':       { code:'RS', name:'Roster',         color:'var(--royal)'  },
  'featured-cases':   { code:'CS', name:'Featured Cases', color:'var(--gold)'   },
  'selected-clients': { code:'HC', name:'Hospitality',    color:'var(--green)'  },
  'brand-partners':   { code:'BP', name:'Brand Partners', color:'var(--purple)' },
  services:           { code:'SV', name:'Services',       color:'var(--red)'    },
  about:              { code:'AU', name:'About',          color:'var(--pink)'   },
  contact:            { code:'TR', name:'Terminus',       color:'var(--carbon)' }
};

// build station rail dynamically from stopMeta (skip contact for the rail —
// it's the terminus, the rail represents en-route stops)
const railEl = document.getElementById('station-rail');
if (railEl) {
  const railOrder = ['our-people','featured-cases','selected-clients','brand-partners','services','about'];
  railEl.innerHTML = '<span class="rail-track"></span>' + railOrder.map(id => {
    const m = stopMeta[id];
    return `<a class="rail-stop" data-section="${id}" href="#${id}" aria-label="Jump to ${m.name}">
      <span class="rs-bullet" style="background:${m.color}">${m.code}</span>
      <span class="rs-label">${m.name}</span>
    </a>`;
  }).join('');
}
const railStops = document.querySelectorAll('.rail-stop');

// chip elements
const chipEl     = document.getElementById('approach-chip');
const chipBullet = chipEl ? chipEl.querySelector('.ac-bullet') : null;
const chipText   = chipEl ? chipEl.querySelector('.ac-text')   : null;
let chipTimer = null, lastAnnounced = null;

function announceStop(id){
  const m = stopMeta[id];
  if (!m || !chipEl || id === lastAnnounced) return;
  lastAnnounced = id;
  chipBullet.style.background = m.color;
  chipBullet.textContent = m.code;
  chipText.innerHTML = `<small>Now approaching</small><b>${m.name}</b>`;
  chipEl.classList.add('in');
  clearTimeout(chipTimer);
  chipTimer = setTimeout(()=>chipEl.classList.remove('in'), 3200);
}

// Re-observe sections so we can drive both rail + chip alongside the nav-link
// active state. We use a fresh observer (rather than piggybacking on navObs)
// because we want to fire announceStop on *transition*, not on every entry.
const stopObs = new IntersectionObserver((entries)=>{
  // pick the entry that's most-visible in this batch
  let best = null;
  entries.forEach(e=>{
    if (!e.isIntersecting) return;
    if (!best || e.intersectionRatio > best.intersectionRatio) best = e;
  });
  if (best) {
    const id = best.target.id;
    railStops.forEach(s => s.classList.toggle('active', s.dataset.section === id));
    announceStop(id);
  }
}, {threshold:[0.35, 0.6]});
['our-people','featured-cases','selected-clients','brand-partners','services','about','contact'].forEach(id=>{
  const el = document.getElementById(id);
  if (el) stopObs.observe(el);
});

// reveal the rail once the user has scrolled past the hero
const heroSection = document.querySelector('.hero');
if (railEl && heroSection) {
  const railVisObs = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      // hero leaving viewport → rail visible; hero in view → rail hidden
      railEl.classList.toggle('visible', !e.isIntersecting);
    });
