setTimeout(()=>document.querySelector('.hero-meta').classList.add('in'), 10);

const progress = document.getElementById('progress');
const nav = document.getElementById('nav');

/* ------------------------------------------------------------
   Scroll orchestrator
   Everything that needs scrollY is batched into ONE rAF loop.
   v2.6 surface area: top progress bar, nav state, hero parallax.
   ------------------------------------------------------------ */

const heroEl    = document.querySelector('.hero');
const aerialEl  = document.querySelector('.hero .aerial');
const heroRight = document.querySelector('.hero-right');
const markEl    = document.querySelector('.mark');

function scrollTick(){
  const y = window.scrollY || document.documentElement.scrollTop || 0;
  const vh = window.innerHeight;
  const dh = document.documentElement.scrollHeight - vh;

  // top progress bar + nav state
  progress.style.width = Math.min(100, Math.max(0, (y/dh)*100)) + '%';
  nav.classList.toggle('scrolled', y > 60);

  // -- HERO PARALLAX -------------------------------------------
  if(heroEl){
    const hr = heroEl.getBoundingClientRect();
    if(hr.bottom > -200 && hr.top < vh){
      const t = Math.min(1, Math.max(0, y / vh));
      if(aerialEl)  aerialEl.style.transform  = `translate3d(0, ${y * 0.18}px, 0) scale(${1 + t*0.05})`;
      if(heroRight) heroRight.style.transform = `translate3d(0, ${-y * 0.12}px, 0)`;
      if(markEl)    markEl.style.transform    = `translate3d(0, ${-y * 0.04}px, 0)`;
    }
  }

}

let tickQueued = false;
function queueTick(){
  if(tickQueued) return;
  tickQueued = true;
  requestAnimationFrame(()=>{ tickQueued = false; scrollTick(); });
}
window.addEventListener('scroll', queueTick, {passive:true});
window.addEventListener('resize', queueTick);
// run once so the initial state is correct
scrollTick();

const sectionIds = ['our-people','featured-cases','selected-clients','brand-partners','services','about','contact'];
const links = document.querySelectorAll('.nav ul a');
const navObs = new IntersectionObserver((entries)=>{
  entries.forEach(en=>{
    if(en.isIntersecting){
      links.forEach(l=>l.classList.toggle('active', l.getAttribute('href') === '#'+en.target.id));
    }
  });
}, {threshold:.35});
sectionIds.forEach(id=>{ const el = document.getElementById(id); if(el) navObs.observe(el); });

const rev = new IntersectionObserver((en)=>{
  en.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); rev.unobserve(e.target); } });
},{threshold:.18});
document.querySelectorAll('.reveal, [data-reveal]').forEach(el=>rev.observe(el));

// count-up
document.querySelectorAll('[data-count]').forEach(el=>{
  const target = +el.dataset.count;
  const pad = (el.textContent||'').length;
  const io = new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
      if(!entry.isIntersecting) return;
      let v = 0, start = performance.now(), dur = 1100;
      (function step(t){
        const k = Math.min(1, (t-start)/dur);
        v = Math.floor(target * (1 - Math.pow(1-k, 3)));
        el.textContent = String(v).padStart(pad, '0');
        if(k<1) requestAnimationFrame(step);
      })(start);
      io.unobserve(el);
    });
  }, {threshold:.5});
  io.observe(el);
});

// cursor
const ring = document.querySelector('.cursor-ring');
const dot  = document.querySelector('.cursor-dot');
