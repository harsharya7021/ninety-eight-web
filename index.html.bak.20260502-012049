.ic-slide .ic-tagline{font:500 clamp(14px,1.5vw,17px)/1.5 var(--display);color:rgba(255,255,255,.92);max-width:42ch;margin-bottom:14px}
.ic-slide .ic-cite{font:600 11px/1 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.92);text-decoration:none;display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid rgba(255,255,255,.5);border-radius:999px;transition:all .25s var(--ease);margin-top:8px}
